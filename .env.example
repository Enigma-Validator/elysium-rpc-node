# =============================================================================
# Elysium RPC node configuration
# Copy to .env (cp .env.example .env). Only PARENT_CHAIN_RPC is required.
# =============================================================================

# -----------------------------------------------------------------------------
# Parent chain (HyperEVM testnet, chain id 998) - REQUIRED
# -----------------------------------------------------------------------------
# The public endpoint works but is heavily rate limited: a first sync from
# scratch takes days with it.
# For a faster sync, use your own HyperEVM node or ask the Hypedexer team on
# Telegram (@wsm_enigma) for access. It must serve history back to HyperEVM block
# 63983746 (Elysium deployment) and accept eth_getLogs over 1000 blocks.
PARENT_CHAIN_RPC=https://rpc.hyperliquid-testnet.xyz/evm

# -----------------------------------------------------------------------------
# Node
# -----------------------------------------------------------------------------
# archive: keeps all historical state (eth_call / eth_getBalance at any block)
# full:    prunes old state, uses less disk
NODE_MODE=archive

# JSON-RPC namespaces exposed over HTTP and WS (add debug for traces)
RPC_API=net,web3,eth

# Interface the RPC ports are published on.
# 127.0.0.1 = this machine only. 0.0.0.0 = reachable from the network
# (put a reverse proxy / firewall in front before doing that).
RPC_BIND=127.0.0.1
HTTP_PORT=8547
WS_PORT=8546
METRICS_PORT=6070

# Nitro Docker image the node is built from
NITRO_IMAGE=offchainlabs/nitro-node:v3.9.5-66e42c4

# -----------------------------------------------------------------------------
# Elysium endpoints (Conduit) - defaults are fine, change only if they move
# -----------------------------------------------------------------------------
# FORWARDING_TARGET=https://rpc-elysium-testnet.t.conduit.xyz
# SEQUENCER_FEED_RELAY=wss://relay-elysium-testnet.t.conduit.xyz/
# DAS_URL=https://das-elysium-testnet.t.conduit.xyz

# Lower this if your parent chain RPC caps eth_getLogs below 1000 blocks
# PARENT_CHAIN_MAX_BLOCKS_TO_READ=1000
